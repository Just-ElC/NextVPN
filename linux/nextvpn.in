#!@PYTHON@
# NextVPN launcher, generated by meson.
import os
import sys

sys.path.insert(1, "@PKGDATADIR@")
# Lets "launch when I sign in" write an entry that starts this exact command.
os.environ.setdefault("NEXTVPN_LAUNCHER", "@LAUNCHER@")

from nextvpn.main import main  # noqa: E402

sys.exit(main())
