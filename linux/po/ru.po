msgstr "Ищем маршрут, который работает в этой сети"

msgid "Closing the tunnel"
msgstr "Закрываем туннель"

msgid "Something went wrong"
msgstr "Что-то пошло не так"

msgid "Your traffic is going out unprotected"
msgstr "Ваш трафик идёт без защиты"

