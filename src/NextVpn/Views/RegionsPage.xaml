<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NextVpn.Views.RegionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:NextVpn.Core"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="12" MaxWidth="1180">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Locations" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource Secondary}"
                       Text="Where your traffic leaves the network. Changing this while connected rebuilds the tunnel." />
        </StackPanel>

        <AutoSuggestBox Grid.Row="1" x:Name="SearchBox"
                        PlaceholderText="Search locations"
                        QueryIcon="Find"
                        TextChanged="OnSearchChanged" />

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4">
          <Grid>
            <!-- The engine reports the country list once it has reached the network,
                 so before the first connection there is only "Best performance". -->
            <StackPanel x:Name="EmptyNote" Spacing="6" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                <FontIcon Glyph="&#xE909;" FontSize="22" HorizontalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock x:Name="EmptyNoteText" Style="{StaticResource Secondary}"
                           TextAlignment="Center" />
            </StackPanel>

            <ListView x:Name="RegionList"
                      ItemsSource="{x:Bind Filtered, Mode=OneWay}"
                      SelectionMode="Single"
                      SelectionChanged="OnRegionSelected"
                      ScrollViewer.VerticalScrollBarVisibility="Hidden"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Margin" Value="0,0,0,2" />
                        <Setter Property="CornerRadius" Value="6" />
                        <Setter Property="Padding" Value="10,8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="core:RegionInfo">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Grid>
                                    <TextBlock Text="{x:Bind Code}"
                                               Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{x:Bind IsCountry, Converter={StaticResource BoolToVisibility}}" />
                                    <FontIcon Glyph="&#xE909;" FontSize="15"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Visibility="{x:Bind IsBest, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyTextBlockStyle}" />
                                <TextBlock Text="{x:Bind Code}" Style="{StaticResource FieldLabel}"
                                           Visibility="{x:Bind IsCountry, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>

                            <FontIcon Grid.Column="2" Glyph="&#xE73E;" FontSize="14"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                      VerticalAlignment="Center"
                                      Visibility="{x:Bind Code, Converter={StaticResource RegionSelected}}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
          </Grid>
        </Border>
    </Grid>
</Page>
