<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NextVpn.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Base layer: the title bar sits directly on mica. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="44" Padding="14,0,140,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Width="18" Height="18" CornerRadius="5"
                        Background="{StaticResource BrandGradient}" />
                <TextBlock Text="NextVPN" Style="{StaticResource CaptionTextBlockStyle}"
                           FontWeight="SemiBold" VerticalAlignment="Center" />

                <Border Width="1" Height="14" Margin="4,0"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <!-- Live status, always visible regardless of the open page.
                     Driven from code-behind: x:Bind is not available on a Window root. -->
                <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusLabel" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <muxc:NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="LeftCompact"
            OpenPaneLength="188"
            IsTitleBarAutoPaddingEnabled="False"
            SelectionChanged="OnNavSelectionChanged">

            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="Connection" Tag="home" IsSelected="True"
                                         ToolTipService.ToolTip="Connection">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE839;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Locations" Tag="regions"
                                         ToolTipService.ToolTip="Locations">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE909;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Settings" Tag="settings"
                                         ToolTipService.ToolTip="Settings">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Activity" Tag="log"
                                         ToolTipService.ToolTip="Activity">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>

            <!-- Content layer, raised off the mica base. -->
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,1,0,0"
                    CornerRadius="8,0,0,0">
                <Frame x:Name="ContentFrame" />
            </Border>
        </muxc:NavigationView>
    </Grid>
</Window>
