<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="NextVpn.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NextVpn">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Only the brand accent is defined per theme. Everything structural uses the
                Fluent system brushes so the app tracks Windows light/dark and contrast
                settings instead of fighting them.
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <Color x:Key="BrandPrimary">#2EE6A8</Color>
                    <Color x:Key="BrandSecondary">#12B886</Color>
                    <Color x:Key="BrandInk">#04140E</Color>
                    <Color x:Key="StateWarn">#F2B441</Color>
                    <Color x:Key="StateBad">#FF6B6B</Color>
                    <Color x:Key="StateIdle">#8A8F98</Color>
                    <Color x:Key="GraphDown">#2EE6A8</Color>
                    <Color x:Key="GraphUp">#5AB9FF</Color>

                    <SolidColorBrush x:Key="BrandInkBrush" Color="#04140E" />
                    <SolidColorBrush x:Key="HeroTintBrush" Color="#2EE6A8" Opacity="0.06" />

                    <!-- Pressed and hover shading for the connect control. Laid over the
                         brand gradient rather than replacing it, which is what a stock
                         Button does and why its gradient vanished on hover. -->
                    <SolidColorBrush x:Key="ConnectScrimBrush" Color="#FFFFFF" />

                    <RadialGradientBrush x:Key="HeroGlowBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5"
                                         RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#802EE6A8" Offset="0.0" />
                        <GradientStop Color="#402EE6A8" Offset="0.55" />
                        <GradientStop Color="#002EE6A8" Offset="1.0" />
                    </RadialGradientBrush>
                </ResourceDictionary>

                <ResourceDictionary x:Key="Light">
                    <Color x:Key="BrandPrimary">#0FA97B</Color>
                    <Color x:Key="BrandSecondary">#0B8A63</Color>
                    <Color x:Key="BrandInk">#FFFFFF</Color>
                    <Color x:Key="StateWarn">#B7791F</Color>
                    <Color x:Key="StateBad">#D64545</Color>
                    <Color x:Key="StateIdle">#6B7280</Color>
                    <Color x:Key="GraphDown">#0FA97B</Color>
                    <Color x:Key="GraphUp">#2F7FD1</Color>

                    <SolidColorBrush x:Key="BrandInkBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="HeroTintBrush" Color="#0FA97B" Opacity="0.05" />
                    <SolidColorBrush x:Key="ConnectScrimBrush" Color="#000000" />

                    <RadialGradientBrush x:Key="HeroGlowBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5"
                                         RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#660FA97B" Offset="0.0" />
                        <GradientStop Color="#330FA97B" Offset="0.55" />
                        <GradientStop Color="#000FA97B" Offset="1.0" />
                    </RadialGradientBrush>
                </ResourceDictionary>

                <ResourceDictionary x:Key="HighContrast">
                    <Color x:Key="BrandPrimary">#00FF00</Color>
                    <Color x:Key="BrandSecondary">#00FF00</Color>
                    <Color x:Key="BrandInk">#000000</Color>
                    <Color x:Key="StateWarn">#FFFF00</Color>
                    <Color x:Key="StateBad">#FF0000</Color>
                    <Color x:Key="StateIdle">#C0C0C0</Color>
                    <Color x:Key="GraphDown">#00FF00</Color>
                    <Color x:Key="GraphUp">#00FFFF</Color>

                    <SolidColorBrush x:Key="BrandInkBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
                    <SolidColorBrush x:Key="HeroTintBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ConnectScrimBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="HeroGlowBrush" Color="Transparent" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <local:LogLevelToBrushConverter x:Key="LogLevelToBrush" />
            <local:RegionSelectedConverter x:Key="RegionSelected" />

            <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{ThemeResource BrandPrimary}" Offset="0" />
                <GradientStop Color="{ThemeResource BrandSecondary}" Offset="1" />
            </LinearGradientBrush>

            <!--
                One spacing rhythm for the whole application: a 12px gutter between
                cards, 16px inside them, 10px corners. Every page uses these rather
                than its own numbers, so rows line up across pages as well as within
                one.
            -->
            <x:Double x:Key="Gutter">12</x:Double>
            <CornerRadius x:Key="CardCorner">10</CornerRadius>
            <Thickness x:Key="CardPadding">14,13,14,13</Thickness>
            <Thickness x:Key="PagePadding">20,14,20,16</Thickness>

            <!--
                Fluent's two-layer model: cards sit on the content layer, which sits on
                the mica base. Card elevation is expressed with a 1px contour, per the
                Windows elevation guidance.
            -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource CardCorner}" />
                <Setter Property="Padding" Value="{StaticResource CardPadding}" />
            </Style>

            <Style x:Key="SubtleCard" TargetType="Border" BasedOn="{StaticResource Card}">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
            </Style>

            <!-- Group label above a set of cards. -->
            <Style x:Key="GroupHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="2,0,0,6" />
            </Style>

            <Style x:Key="Secondary" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- Label above a value in the data tiles. -->
            <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="FieldValue" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <!-- The three headline numbers. One size, one weight, one baseline. -->
            <Style x:Key="StatValue" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="Margin" Value="0,0,0,2" />
            </Style>

            <!-- Small state chip: protocol, exit code, anything one word long. -->
            <Style x:Key="Pill" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="12,4" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!--
                A whole card that is also a button.

                The state shading is a separate layer over the card face instead of a
                replacement background, so the card keeps its own colour, contour and
                corner radius while still giving hover and press feedback.
            -->
            <Style x:Key="CardButton" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource CardCorner}" />
                <Setter Property="Padding" Value="{StaticResource CardPadding}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <!-- The visual states have to be declared on the template's
                                 own root element. Nested one level deeper they parse,
                                 build and do nothing at all: the control never finds
                                 them, so hover and press produce no feedback. -->
                            <Grid x:Name="Root">
                                <Border x:Name="Face"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{TemplateBinding CornerRadius}" />
                                <Border x:Name="Shade" CornerRadius="{TemplateBinding CornerRadius}" />
                                <ContentPresenter x:Name="Presenter"
                                                  Padding="{TemplateBinding Padding}"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Shade.Background"
                                                        Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Shade.Background"
                                                        Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Opacity" Value="0.5" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                The connect control.

                A stock Button cannot carry this: its template swaps the background for
                a theme brush in the pointer-over, pressed and disabled states, which
                replaced the brand gradient with flat grey the moment the pointer
                touched it. Here the gradient is the face and the states are a scrim
                over the top, so it stays itself in every state.

                The focus ring is drawn as a circle for the same reason - the system
                focus visual is a rectangle, which around a 120px disc looks like a
                mistake.
            -->
            <Style x:Key="ConnectButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource BrandGradient}" />
                <Setter Property="Foreground" Value="{ThemeResource BrandInkBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root" Background="Transparent">
                                <Ellipse x:Name="FocusRing" Margin="-5"
                                         Stroke="{ThemeResource FocusStrokeColorOuterBrush}"
                                         StrokeThickness="2" Opacity="0" />
                                <Ellipse x:Name="Face" Fill="{TemplateBinding Background}" />
                                <Ellipse x:Name="Scrim" Fill="{ThemeResource ConnectScrimBrush}" Opacity="0" />
                                <ContentPresenter x:Name="Presenter"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Scrim.Opacity" Value="0.12" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Scrim.Opacity" Value="0.22" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Opacity" Value="0.45" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>

                                    <VisualStateGroup x:Name="FocusStates">
                                        <VisualState x:Name="Focused">
                                            <VisualState.Setters>
                                                <Setter Target="FocusRing.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PointerFocused" />
                                        <VisualState x:Name="Unfocused" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
