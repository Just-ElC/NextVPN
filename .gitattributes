# Line endings are normalised in the repository and checked out native, so a
# contributor on any platform gets a sane working copy.
* text=auto

# PowerShell is run by Windows PowerShell here, which wants CRLF.
*.ps1 text eol=crlf

# The engine reads these byte for byte and verifies the server list against a
# signature. Normalising them would silently produce a file the engine rejects.
engine/server_list.dat binary
engine/base.config     binary

# Linux: the engine is a binary, and scripts must keep LF line endings even in a
# Windows checkout, or they stop running once copied to a Linux machine.
linux/engine/psiphon-tunnel-core-* binary
*.sh          text eol=lf
*.in          text eol=lf
PKGBUILD      text eol=lf
*.spec        text eol=lf
*.nix         text eol=lf
*.py          text eol=lf

*.exe binary
*.dll binary
*.ico binary
*.png binary
*.pri binary
